# TODO - broken
runs/*
# Pre-trained YOLO models
*.pt

# Has over 1GB of image data (GitHub limit 100MB per file)
datasets/images/*
datasets/labels/*
tmp/*

# Allow the folders themselves and .gitkeep (GitHub doesn't track empty folders)
!datasets/images/.gitkeep
!datasets/labels/.gitkeep
!tmp/.gitkeep

# Python Virtual Enviroment
envs/matterport_env/*
envs/yolo_env/*
!envs/matterport_env/.gitkeep
!envs/yolo_env/.gitkeep

# Any cached python info
**/__pycache__/
*.pyc
